{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://townscape-guides.local/schemas/historic-town-project.schema.json",
  "title": "Townscape Guides project package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "features",
    "sources",
    "historicMaps",
    "settlementPolygons",
    "validation"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "publication": { "$ref": "#/$defs/publicationDeclaration" },
    "licenceDecision": { "$ref": "#/$defs/licenceDecision" },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "countryCode",
        "country",
        "locality",
        "centre",
        "boundary",
        "boundarySource",
        "boundaryConfidence",
        "sourceLanguage",
        "preferredBasemap",
        "createdAt",
        "methodology"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "countryCode": { "type": "string", "minLength": 2 },
        "country": { "type": "string", "minLength": 1 },
        "region": { "type": "string" },
        "locality": { "type": "string", "minLength": 1 },
        "centre": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2
        },
        "boundary": { "type": "object" },
        "boundarySource": { "type": "string", "minLength": 1 },
        "boundaryConfidence": {
          "enum": ["high", "medium", "low", "unknown"]
        },
        "sourceLanguage": { "type": "string", "minLength": 1 },
        "preferredBasemap": { "type": "string", "minLength": 1 },
        "createdAt": { "$ref": "#/$defs/dateStamp" },
        "timelineStart": { "type": "number" },
        "timelineEnd": { "type": "number" },
        "methodology": { "type": "object" },
        "researchNotes": { "type": "string" },
        "townStudyArea": { "type": "object" }
      }
    },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/heritageFeature" }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "licenceDecision": { "$ref": "#/$defs/licenceDecision" }
        }
      }
    },
    "historicMaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "publication": { "$ref": "#/$defs/publicationDeclaration" },
          "licenceDecision": { "$ref": "#/$defs/licenceDecision" }
        }
      }
    },
    "settlementPolygons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "publication": { "$ref": "#/$defs/publicationDeclaration" },
          "licenceDecision": { "$ref": "#/$defs/licenceDecision" }
        }
      }
    },
    "validation": { "type": "array" },
    "curationMetadata": { "type": "object" },
    "publicationSummary": { "type": "object" },
    "licensingMetadata": {
      "type": "object",
      "required": ["components"],
      "properties": {
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataLicenceComponent" }
        }
      }
    }
  },
  "$defs": {
    "dateStamp": {
      "type": "string",
      "anyOf": [{ "format": "date" }, { "format": "date-time" }]
    },
    "publicationDeclaration": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": ["provisional", "verified", "publishable", "withheld"]
        },
        "profile": {
          "enum": ["mapped_context", "verified_facility", "editorial"]
        },
        "reviewedAt": { "$ref": "#/$defs/dateStamp" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "licenceDecision": {
      "type": "object",
      "required": ["state", "scope", "reviewedAt"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": ["approved", "unresolved", "denied", "restricted", "inherited"]
        },
        "scope": {
          "enum": ["public_metadata", "public_redistribution", "internal_only"]
        },
        "reviewedAt": { "$ref": "#/$defs/dateStamp" },
        "evidenceText": { "type": "string", "minLength": 1 },
        "evidenceSnapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "licence": { "type": "string" },
            "sourceRecordId": { "type": "string" },
            "sourceUrl": { "type": "string", "format": "uri" },
            "sourceName": { "type": "string" },
            "sourceOrganisation": { "type": "string" }
          }
        },
        "inheritedFrom": { "const": "source_records" }
      }
    },
    "claimEvidence": {
      "type": "object",
      "required": ["claim", "tier", "sourceRecordRefs", "reviewedAt"],
      "additionalProperties": false,
      "properties": {
        "claim": {
          "enum": [
            "mapped_identity",
            "public_access",
            "opening_hours",
            "fees",
            "accessibility",
            "operator",
            "capacity",
            "current_operation",
            "route_access",
            "temporary_closure",
            "ev_charging_operation",
            "editorial_recommendation",
            "visitor_score",
            "visitor_suitability"
          ]
        },
        "tier": {
          "enum": ["mapped_context", "corroborated_facility", "operational", "editorial"]
        },
        "sourceRecordRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "reviewedAt": { "$ref": "#/$defs/dateStamp" },
        "expiresAt": { "$ref": "#/$defs/dateStamp" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "osmElementMetadata": {
      "type": "object",
      "required": ["elementType", "elementId", "status", "checkedAt"],
      "additionalProperties": false,
      "properties": {
        "elementType": { "enum": ["node", "way", "relation"] },
        "elementId": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "lastEditedAt": { "$ref": "#/$defs/dateStamp" },
        "changesetId": { "type": "integer", "minimum": 1 },
        "visible": { "type": "boolean" },
        "status": { "enum": ["current", "deleted", "unavailable"] },
        "checkedAt": { "$ref": "#/$defs/dateStamp" }
      }
    },
    "dataLicenceComponent": {
      "type": "object",
      "required": ["id", "name", "source", "licence", "attribution", "scope"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "licence": { "type": "string", "minLength": 1 },
        "licenceDecision": { "$ref": "#/$defs/licenceDecision" },
        "licenceUrl": { "type": "string", "format": "uri" },
        "attribution": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "legalReviewNote": { "type": "string", "minLength": 1 }
      }
    },
    "sourceRecord": {
      "type": "object",
      "required": ["sourceName", "sourceOrganisation", "accessedAt", "reliability"],
      "properties": {
        "sourceName": { "type": "string" },
        "sourceOrganisation": { "type": "string" },
        "sourceRecordId": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "sourceUrl": { "type": "string", "format": "uri" },
        "accessedAt": { "$ref": "#/$defs/dateStamp" },
        "licence": { "type": "string" },
        "licenceDecision": { "$ref": "#/$defs/licenceDecision" },
        "quotedDateText": { "type": "string" },
        "notes": { "type": "string" },
        "reliability": {
          "enum": [
            "official_statutory",
            "official_non_statutory",
            "academic",
            "local_authority",
            "archival",
            "secondary",
            "discovery_only"
          ]
        }
      }
    },
    "heritageFeature": {
      "type": "object",
      "required": [
        "id",
        "projectId",
        "name",
        "alternativeNames",
        "countryCode",
        "featureType",
        "locationType",
        "dateBasis",
        "dateConfidence",
        "locationConfidence",
        "sourceRecords",
        "tags",
        "createdAt",
        "updatedAt",
        "reviewed"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "alternativeNames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "countryCode": { "type": "string", "minLength": 2 },
        "featureType": { "type": "string", "minLength": 1 },
        "locationType": { "type": "string", "minLength": 1 },
        "dateBasis": {
          "enum": [
            "documented_construction",
            "documented_date_range",
            "present_by",
            "first_mapped",
            "estimated_from_authoritative_source",
            "estimated_from_map_comparison",
            "unknown"
          ]
        },
        "dateConfidence": { "enum": ["high", "medium", "low", "unknown"] },
        "locationConfidence": { "enum": ["high", "medium", "low", "unknown"] },
        "sourceRecords": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRecord" }
        },
        "licence": { "type": "string" },
        "licenceDecision": { "$ref": "#/$defs/licenceDecision" },
        "geometry": {
          "anyOf": [{ "type": "object" }, { "type": "null" }]
        },
        "reviewed": { "type": "boolean" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "$ref": "#/$defs/dateStamp" },
        "updatedAt": { "$ref": "#/$defs/dateStamp" },
        "evidenceScope": {
          "enum": ["parish_evidence", "related_context", "out_of_scope"]
        },
        "geographicScope": {
          "type": "object",
          "required": [
            "classification",
            "boundaryName",
            "boundarySource",
            "verifiedAt",
            "rationale"
          ],
          "additionalProperties": false,
          "properties": {
            "classification": {
              "enum": [
                "within_town_locality",
                "immediately_associated",
                "related_context",
                "ambiguous",
                "out_of_scope"
              ]
            },
            "boundaryName": { "type": "string", "minLength": 1 },
            "boundarySource": { "type": "string", "minLength": 1 },
            "verifiedAt": { "$ref": "#/$defs/dateStamp" },
            "rationale": { "type": "string", "minLength": 1 }
          }
        },
        "publication": { "$ref": "#/$defs/publicationDeclaration" },
        "claimEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/claimEvidence" }
        },
        "osmElement": { "$ref": "#/$defs/osmElementMetadata" }
      }
    }
  }
}
