# Public API and HES-proxy safeguards. Values are milliseconds unless stated otherwise.
HES_REQUEST_TIMEOUT_MS=10000
HES_CACHE_TTL_MS=3600000
HES_CACHE_STALE_TTL_MS=86400000
HES_CACHE_MAX_ENTRIES=256
API_RATE_LIMIT_MAX=120
HES_RATE_LIMIT_MAX=30
API_RATE_LIMIT_WINDOW_MS=60000
