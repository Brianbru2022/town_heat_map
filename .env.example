# A production build must have an explicit basemap. The tracked production
# candidate uses the reviewed OSM raster origin; do not rely on the dev fallback.
VITE_BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Production styles, sprites and glyphs must be served same-origin or explicitly
# reviewed and added to the nginx CSP before deployment.
VITE_MAP_STYLE_URL=
# Local-development fallback only. Published historic overlays use same-origin
# /api/local-historic-maps routes in production.
VITE_HISTORIC_TILE_SERVER_URL=http://localhost:8081
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
VITE_GEOCODER_PROVIDER=local
VITE_GEOCODER_API_URL=http://localhost:3001/api/geocode
VITE_GEOCODER_API_KEY=
VITE_BACKEND_URL=http://localhost:3001
VITE_ENABLE_LOCAL_MAP_REVIEWS=false
HES_LOCAL_DATA_DIR=D:\Map Data\Scotland HES
DATABASE_URL=postgres://historic:historic@localhost:5432/historic_towns
# The standalone API listens only on loopback by default. The production Compose
# service overrides this inside its private network; never publish its port.
API_BIND_ADDRESS=127.0.0.1
# Production is same-origin by default. Add the exact public browser origins only if cross-origin API access is required.
CORS_ORIGINS=
# Trust forwarded client addresses only from the named reverse-proxy ranges. Leave
# empty for a direct local API; Compose safely uses its private network default.
TRUST_PROXY_CIDRS=
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
# Public API and HES-proxy safeguards. Values are milliseconds unless stated otherwise.
HES_REQUEST_TIMEOUT_MS=10000
HES_CACHE_TTL_MS=3600000
HES_CACHE_STALE_TTL_MS=86400000
HES_CACHE_MAX_ENTRIES=256
API_RATE_LIMIT_MAX=120
HES_RATE_LIMIT_MAX=30
API_RATE_LIMIT_WINDOW_MS=60000
